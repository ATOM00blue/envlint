[meta]
complete = true

[vars.DATABASE_URL]
required = true
type = "url"
description = "Postgres connection string"

[vars.PORT]
type = "port"
default = "8000"

[vars.LOG_LEVEL]
allowed = ["debug", "info", "warn", "error"]
default = "info"

[vars.ADMIN_EMAIL]
type = "email"
required = false

[vars.API_KEY]
required = true
secret = true
